{
  "name": "altin",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm start -w apps/api",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck --workspaces"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
