    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@hono/node-server": "^2.1.6",
    "ai": "^7.0.166",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
